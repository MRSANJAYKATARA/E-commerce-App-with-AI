# ExamLegacy — Apache configuration
# Front controller for the API + hard protection of sensitive paths.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Pass Authorization and custom auth headers through to PHP (FastCGI / Shared Hosting)
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  RewriteCond %{HTTP:X-Authorization} .
  RewriteRule .* - [E=HTTP_X_AUTHORIZATION:%{HTTP:X-Authorization}]

  RewriteCond %{HTTP:X-Firebase-Token} .
  RewriteRule .* - [E=HTTP_X_FIREBASE_TOKEN:%{HTTP:X-Firebase-Token}]

  # Never serve secrets, dependencies, migrations, docs or PHP internals.
  RewriteRule (^|/)\.env - [F,L]
  RewriteRule ^vendor/ - [F,L]
  RewriteRule ^migrations/ - [F,L]
  RewriteRule ^docs/ - [F,L]
  RewriteRule ^storage/ - [F,L]
  RewriteRule ^config/ - [F,L]
  RewriteRule ^api/lib/ - [F,L]
  RewriteRule ^api/config\.php$ - [F,L]
  RewriteRule ^composer\.(json|lock)$ - [F,L]

  # Privacy Policy route (DPDP Act, 2023)
  RewriteRule ^privacy/?$ privacy.html [L]

  # 1-Click Database Installer route
  RewriteRule ^install/?$ install.php [L]

  # Route all /api requests to the front controller.
  RewriteRule ^api(/.*)?$ api/index.php [QSA,L]
</IfModule>

# Extra hardening
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header set X-Permitted-Cross-Domain-Policies "none"
</IfModule>

# Deny access to dotfiles
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
