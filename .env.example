# ============================================================================
# ExamLegacy — environment configuration (COPY to .env and fill in).
# NEVER commit the real .env. Secrets live only here / in server env vars.
# ============================================================================

# --- App ---
APP_ENV=production            # production | development
APP_URL=https://your-domain.com
APP_DEBUG=0                   # 1 only in local dev; never expose errors in prod

# --- MySQL (authoritative data store) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=examlegacy
DB_USER=examlegacy
DB_PASS=change-me
DB_CHARSET=utf8mb4

# --- Firebase (Google Sign-In). Server verifies ID tokens ---
FIREBASE_PROJECT_ID=your-firebase-project-id
# Path to service-account JSON for privileged server calls (optional). Keep OUTSIDE webroot.
FIREBASE_SERVICE_ACCOUNT=/absolute/path/to/serviceAccount.json

# --- Cashfree (server-side verification is the source of truth) ---
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox          # sandbox | production
CASHFREE_API_VERSION=2023-08-01
CASHFREE_WEBHOOK_SECRET=

# --- Gemini API (server-only key; never sent to the browser) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta

# --- SMTP (PHPMailer) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=sanjayxlegacysupport@gmail.com
SMTP_FROM_NAME=ExamLegacy
SMTP_SECURE=tls               # tls | ssl | ''

# --- Secure PDF storage (PROTECTED; keep outside webroot in production) ---
# Absolute path to the folder holding purchased PDFs and user uploads.
STORAGE_PATH=/var/www/examlegacy/storage
PDFS_DIR=pdfs
UPLOADS_DIR=uploads
PUBLIC_MEDIA_DIR=public       # public-safe cover images only

# --- Security ---
# Random 32+ byte secret used to sign short-lived viewer tokens (openssl).
VIEWER_TOKEN_SECRET=generate-a-long-random-string
VIEWER_SESSION_TTL=900        # seconds (short-lived)
