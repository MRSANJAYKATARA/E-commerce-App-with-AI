# ExamLegacy env template — copy to .env and fill real values (never commit .env)
APP_NAME=ExamLegacy
APP_ENV=production
APP_URL=https://your-domain.example
APP_DEBUG=0
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database
DB_USER=your_db_user
DB_PASS=your_db_password
DB_CHARSET=utf8mb4
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_SERVICE_ACCOUNT=config/firebase-service-account.json
FIREBASE_API_KEY=your-web-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.app
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxx
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
CASHFREE_APP_ID=your_app_id
CASHFREE_SECRET_KEY=your_secret_key
CASHFREE_ENV=production
CASHFREE_API_VERSION=2023-08-01
CASHFREE_WEBHOOK_SECRET=your_webhook_secret
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=your-smtp-user@gmail.com
SMTP_PASS=your_smtp_app_password
SMTP_FROM=your-smtp-user@gmail.com
SMTP_FROM_NAME=ExamLegacy
ADMIN_EMAILS=your-admin-email@example.com
ADMIN_PASSWORD=change_this_strong_admin_password
ADMIN_SECRET=change_this_random_secret_string
VIEWER_TOKEN_SECRET=change_this_random_token_secret
VIEWER_SESSION_TTL=7200
PDFS_DIR=storage/pdfs
UPLOADS_DIR=storage/uploads
PUBLIC_MEDIA_DIR=storage/public
STORAGE_PATH=storage
